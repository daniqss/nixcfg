{
  "C_Cpp.intelliSenseEngine": "disabled",
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true,
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true,
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
  },
  "[mdx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
  },
  "[nix]": {
    "editor.formatOnSave": true,
  },
  "[qml]": {
    "editor.defaultFormatter": "delgan.qml-format",
    "editor.formatOnSave": true,
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "editor.fontFamily": "'CaskaydiaCove Nerd Font', 'Courier New', monospace",
  "editor.fontLigatures": true,
  "window.zoomLevel": -1,
  "editor.fontSize": 19,
  "editor.mouseWheelZoom": true,
  "editor.stickyScroll.enabled": false,
  "explorer.confirmDragAndDrop": false,
  "git.autofetch": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "cpp": true,
    "rust": true,
    "sql": false,
    "typescript": true,
    "python": false,
  },
  "github.copilot.selectedCompletionModel": "gpt-4o-copilot",
  "java.completion.favoriteStaticMembers": [
    "org.junit.Assert.*",
    "org.junit.Assume.*",
    "org.junit.jupiter.api.Assertions.*",
    "org.junit.jupiter.api.Assumptions.*",
    "org.junit.jupiter.api.DynamicContainer.*",
    "org.junit.jupiter.api.DynamicTest.*",
    "org.mockito.Mockito.*",
    "org.mockito.ArgumentMatchers.*",
    "org.mockito.Answers.*",
  ],
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
  "[latex]": {
    "editor.formatOnSave": false,
  },
  "[tex]": {
    "editor.formatOnSave": false,
  },
  "makefile.configureOnOpen": true,
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["alejandra"],
      },
      "options": {
        "nixos": {
          "expr": "import (builtins.getFlake \"/home/daniqss/nixcfg\").inputs.nixpkgs { }",
        },
      },
      "diagnostic": {
        "suppress": ["variable-not-used"],
      },
    },
  },
  "nix.formatterPath": "alejandra",
  "qt-qml.doNotAskForQmllsDownload": true,
  "qt-qml.qmlls.customExePath": "/home/daniqss/.nix-profile/bin/qmlls",
  "qt-qml.qmlls.useQmlImportPathEnvVar": true,
  "redhat.telemetry.enabled": false,
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.diagnostics.styleLints.enable": true,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.lifetimeElisionHints.useParameterNames": true,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font', monospace",
  "terminal.integrated.fontSize": 15,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "window.titleBarStyle": "custom",
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.jpeg": "imagePreview.previewEditor",
    "*.odp": "default",
    "*.wav": "default",
    "*.qrc": "qt-core.qrcEditor",
  },
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "zig.zls.enabled": "on",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "explorer.confirmPasteNative": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "ty.inlayHints.variableTypes": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
  },
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.highlightedyank.enable": true,
  "vim.handleKeys": {
    "<C-p>": false,
  },
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.replace": "underline",
  "vim.cursorStylePerMode.visual": "underline",
  "vim.cursorStylePerMode.visualline": "underline",
  "vim.cursorStylePerMode.visualblock": "underline",
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["g", "h"], "after": ["0"] },
    { "before": ["g", "l"], "after": ["$"] },
    { "before": ["g", "s"], "after": ["^"] },
    { "before": ["U"], "after": ["<C-r>"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    { "before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"] },
    { "before": ["g", "I"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["]", "d"], "commands": ["editor.action.marker.next"] },
    { "before": ["[", "d"], "commands": ["editor.action.marker.prev"] },
    { "before": ["]", "g"], "commands": ["workbench.action.editor.nextChange"] },
    { "before": ["[", "g"], "commands": ["workbench.action.editor.previousChange"] },
    { "before": ["<leader>", "f"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "b"], "commands": ["workbench.action.showAllEditors"] },
    { "before": ["<leader>", "s"], "commands": ["workbench.action.gotoSymbol"] },
    { "before": ["<leader>", "S"], "commands": ["workbench.action.showAllSymbols"] },
    { "before": ["<leader>", "d"], "commands": ["workbench.actions.view.problems"] },
    { "before": ["<leader>", "g"], "commands": ["workbench.view.scm"] },
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "/"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "r"], "commands": ["editor.action.rename"] },
    { "before": ["<leader>", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["<leader>", "k"], "commands": ["editor.action.showHover"] },
    { "before": ["<leader>", "y"], "after": ["\"", "+", "y"] },
    { "before": ["<leader>", "p"], "after": ["\"", "+", "p"] },
    { "before": ["<leader>", "P"], "after": ["\"", "+", "P"] },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["g", "h"], "after": ["0"] },
    { "before": ["g", "l"], "after": ["g", "_"] },
    { "before": ["g", "s"], "after": ["^"] },
    { "before": ["<leader>", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["<leader>", "y"], "after": ["\"", "+", "y"] },
    { "before": ["<leader>", "p"], "after": ["\"", "+", "p"] },
    { "before": ["<leader>", "P"], "after": ["\"", "+", "P"] },
  ],
  "vim.operatorPendingModeKeyBindingsNonRecursive": [
    { "before": ["g", "h"], "after": ["0"] },
    { "before": ["g", "l"], "after": ["$"] },
    { "before": ["g", "s"], "after": ["^"] },
  ],
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  }
}
